{
  "name": "pokeralpha-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PokerAlpha desktop overlay (local development preview). Analysis only: never clicks, bets or controls a poker client.",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6",
    "@types/node": "^22"
  },
  "build": {
    "appId": "dev.pokeralpha.desktop",
    "productName": "PokerAlpha",
    "files": [
      "build/**",
      "renderer/**"
    ],
    "mac": {
      "target": "dir",
      "identity": null
    },
    "directories": {
      "output": "release"
    }
  }
}